# GEMINI_API_KEY: Optional/Default for AI Studio features
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"

# ==========================================
# SUPER KASIR TOKO - Supabase Configuration
# ==========================================
# Supabase Project URL (Client & Server)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# Supabase Anon / Publishable Key (Client safe)
VITE_SUPABASE_ANON_KEY="your-anon-key-here"

# Supabase Service Role Key (Server-only / CLI migration only, NEVER expose to client)
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# Super Admin Initial Bootstrap Email
SUPER_ADMIN_EMAIL="admin@superkasir.com"
